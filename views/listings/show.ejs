<% layout("/layouts/boilerplate") %>

<div class="container py-4">

    <!-- Listing Title -->
    <div class="mb-3">

        <h2 class="fw-bold">
            <%= listing.title %>
        </h2>

        <div class="text-muted">

            ⭐ 4.9 ·
            <%= listing.location %>,
            <%= listing.country %>

        </div>

    </div>

    <!-- Main Image -->

    <div class="mb-4">

        <img
            src="<%= listing.image.url %>"
            class="img-fluid rounded-4 shadow"
            style="
                width:100%;
                height:520px;
                object-fit:cover;
            "
        >

    </div>

    <div class="row">

        <!-- LEFT SIDE -->

        <div class="col-lg-8">

            <div class="border-bottom pb-4">

                <h4>

                    Entire Place hosted by

                    <%= listing.owner.username %>

                </h4>

                <p class="text-muted">

                    📍 <%= listing.location %>,
                    <%= listing.country %>

                </p>

            </div>

            <div class="mt-4">

                <h4>
                    About this place
                </h4>

                <p class="mt-3">

                    <%= listing.description %>

                </p>

            </div>

            <hr>

            <div class="row text-center">

                <div class="col-md-4">

                    <h5>

                        💰 Price

                    </h5>

                    <p>

                        ₹ <%= listing.price.toLocaleString("en-IN") %>

                        / night

                    </p>

                </div>

                <div class="col-md-4">

                    <h5>

                        🏷 Category

                    </h5>

                    <p>

                        <%= listing.category %>

                    </p>

                </div>

                <div class="col-md-4">

                    <h5>

                        👤 Host

                    </h5>

                    <p>

                        @<%= listing.owner.username %>

                    </p>

                </div>

            </div>

            <hr>

                        <!-- Property Location -->

            <h3 class="mt-5 mb-3">
                Property Location
            </h3>

            <div
                id="map"
                style="
                    height:400px;
                    border-radius:18px;
                    overflow:hidden;
                "
                class="shadow-sm mb-5"
            ></div>

            <!-- Edit/Delete Buttons -->

            <% if(currUser && listing.owner._id.equals(currUser._id)){ %>

            <div class="mb-5">

                <a
                    href="/listings/<%= listing._id %>/edit"
                    class="btn btn-warning me-2"
                >
                    Edit Listing
                </a>

                <form
                    action="/listings/<%= listing._id %>?_method=DELETE"
                    method="POST"
                    style="display:inline;"
                >

                    <button
                        class="btn btn-danger"
                    >
                        Delete Listing
                    </button>

                </form>

            </div>

            <% } %>

        </div>

        <!-- ==========================
                BOOKING CARD
        =========================== -->

        <div class="col-lg-4">

            <div
                class="card shadow-lg border-0"
                style="
                    position:sticky;
                    top:100px;
                    border-radius:20px;
                "
            >

                <div class="card-body p-4">

                    <h3>

                        ₹ <%= listing.price.toLocaleString("en-IN") %>

                        <small class="text-muted fs-6">

                            / night

                        </small>

                    </h3>

                    <hr>

                    <% if(currUser){ %>

                    <form
                        action="/bookings/<%= listing._id %>"
                        method="POST"
                    >

                        <div class="mb-3">

                            <label>

                                Check-In

                            </label>

                            <input
                                type="date"
                                id="checkIn"
                                name="checkIn"
                                class="form-control"
                                required
                            >

                        </div>

                        <div class="mb-3">

                            <label>

                                Check-Out

                            </label>

                            <input
                                type="date"
                                id="checkOut"
                                name="checkOut"
                                class="form-control"
                                required
                            >

                        </div>

                        <div class="mb-3">

                            <label>

                                Guests

                            </label>

                            <input
                                type="number"
                                class="form-control"
                                name="guests"
                                value="1"
                                min="1"
                                max="10"
                            >

                        </div>

                        <hr>

                        <h4>

                            Total :

                            ₹

                            <span id="totalPrice">

                                <%= listing.price.toLocaleString("en-IN") %>

                            </span>

                        </h4>

                        <button
                            class="btn btn-danger w-100 mt-3"
                        >

                            Reserve

                        </button>

                    </form>

                    <% } else { %>

                        <a
                            href="/login"
                            class="btn btn-danger w-100"
                        >

                            Login to Book

                        </a>

                    <% } %>

                </div>

            </div>

        </div>

    </div>

    <hr class="my-5">

    <!-- ==========================
        REVIEW SECTION
========================== -->

<% if(currUser){ %>

<h3 class="mb-4">

    Leave a Review

</h3>

<form
    action="/listings/<%= listing._id %>/reviews"
    method="POST"
    class="mb-5"
>

    <div class="mb-3">

        <label class="form-label">

            Rating

        </label>

        <input
            type="range"
            min="1"
            max="5"
            value="5"
            name="review[rating]"
            class="form-range"
        >

    </div>

    <div class="mb-3">

        <label class="form-label">

            Comment

        </label>

        <textarea
            class="form-control"
            rows="4"
            name="review[comment]"
            required
        ></textarea>

    </div>

    <button class="btn btn-dark">

        Submit Review

    </button>

</form>

<% } %>

<hr>

<h3 class="mb-4">

    Guest Reviews

</h3>

<div class="row">

<% if(listing.reviews.length === 0){ %>

<div class="col-12">

<div class="alert alert-secondary">

No Reviews Yet.

</div>

</div>

<% } %>

<% for(let review of listing.reviews){ %>

<div class="col-md-6 mb-4">

<div class="card border-0 shadow-sm rounded-4 h-100">

<div class="card-body">

<h5>

@<%= review.author.username %>

</h5>

<div class="mb-2">

⭐ ⭐ ⭐ ⭐ ⭐

<strong>

(<%= review.rating %>/5)

</strong>

</div>

<p>

<%= review.comment %>

</p>

<% if(currUser && review.author._id.equals(currUser._id)){ %>

<form
action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
method="POST"
>

<button
class="btn btn-sm btn-outline-danger"
>

Delete Review

</button>

</form>

<% } %>

</div>

</div>

</div>

<% } %>

</div>

<!-- ==========================
        LEAFLET MAP
========================== -->

<link
rel="stylesheet"
href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>

const listing = <%- JSON.stringify(listing) %>;

</script>

<script src="/js/map.js"></script>

<!-- ==========================
      BOOKING PRICE SCRIPT
========================== -->

<script>

const pricePerNight = Number(<%= listing.price %>);

const checkIn = document.getElementById("checkIn");
const checkOut = document.getElementById("checkOut");
const totalPrice = document.getElementById("totalPrice");

if(checkIn && checkOut && totalPrice){

    // Today's date
    const today = new Date().toISOString().split("T")[0];

    checkIn.min = today;
    checkOut.min = today;

    function calculatePrice(){

        if(!checkIn.value || !checkOut.value){

            totalPrice.innerHTML =
            pricePerNight.toLocaleString("en-IN");

            return;
        }

        const start = new Date(checkIn.value);
        const end = new Date(checkOut.value);

        const diffTime = end.getTime() - start.getTime();

        const nights = Math.ceil(
            diffTime / (1000 * 60 * 60 * 24)
        );

        if(nights <= 0){

            alert("Check-out must be after Check-in");

            totalPrice.innerHTML =
            pricePerNight.toLocaleString("en-IN");

            return;
        }

        totalPrice.innerHTML =
        (nights * pricePerNight).toLocaleString("en-IN");
    }

    checkIn.addEventListener("change", function(){

        checkOut.min = checkIn.value;

        calculatePrice();

    });

    checkOut.addEventListener("change", calculatePrice);

}

</script>

</div>